# ════════════════════════════════════════════════════════════════════════
#  Template for the env files used by Docker Compose.
#
#  Local dev:  cp .env.example .env.local   (read by docker-compose.yml)
#  On the VPS: cp .env.example .env          (read by docker-compose.prod.yml
#                                             / docker-compose.stage.yml — keep
#                                             only the RUNTIME vars there)
#
#  NEVER commit a filled-in copy — .gitignore keeps .env / .env.* out, and this
#  is a public repo.
# ════════════════════════════════════════════════════════════════════════

# ── BUILD-TIME (baked into the astro image at `astro build`) ──────────────
# Passed as Docker build args. In CI these come from the STAGE_PB_URL /
# PROD_PB_URL repo secrets + a hardcoded SITE_URL per environment.

# PocketBase base URL the build fetches projects/services from. If empty or
# unreachable the build falls back to bundled seed data (astro/src/lib/seed-data.ts).
PB_URL=

# Canonical site origin — used for <link rel="canonical">, hreflang, sitemap.
SITE_URL=http://localhost:4321

# ── RUNTIME (read by the Node server / the /api/contact endpoint) ─────────
# These belong in the VPS `.env` (env_file: in the prod/stage compose). They
# are NOT GitHub Actions secrets and never pass through CI.

# Resend API key for the contact form.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=hello@example.com
# Verified Resend sender, e.g. "MicioDev <hello@micio86dev.it>".
CONTACT_FROM_EMAIL=MicioDev <hello@example.com>
# Optional — only if you write submissions back to a PocketBase `messages` collection.
PB_ADMIN_TOKEN=

# ── PocketBase first-run superuser (local dev convenience only) ───────────
# Not used by Astro. Handy for bootstrapping the local PocketBase admin:
#   docker compose exec pocketbase /pb/pocketbase superuser upsert "$PB_ADMIN_EMAIL" "$PB_ADMIN_PASSWORD"
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=changeme
