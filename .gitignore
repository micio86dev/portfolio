# ── Environment — NEVER commit (this is a public repo) ─────────────────
.env
.env.*
!.env.example

# ── Astro / Node ───────────────────────────────────────────────────────
node_modules/
dist/
.output/
.astro/
# The lockfiles MUST be committed (CI runs `bun install --frozen-lockfile` in
# astro/; the root still uses npm + Husky). Re-include them in case a global
# ~/.gitignore ignores bun.lock or package-lock.json.
!astro/bun.lock
!/package-lock.json

# ── PocketBase ─────────────────────────────────────────────────────────
# The committed binary in pb/ is a local (macOS) build; the image downloads
# the pinned Linux build at build time. Never commit either binary or data.
pb/pocketbase
pb/pb_data/
# PocketBase backup archives (Settings → Backups) — contain live records incl.
# contact-form submissions (emails/PII). NEVER commit to this public repo.
pb_backup*.zip
**/pb_backup*.zip

# ── Logs ───────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor / OS ────────────────────────────────────────────────────────
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# ── Claude Code ───────────────────────────────────────────────────────
.claude/
