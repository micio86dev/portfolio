# Astro env — copy to `.env` for `astro dev` / `astro build` run directly on
# the host. When running via Docker, PUBLIC_PB_URL is injected at container
# start (see ../docker-compose*.yml) — see ../.env.example.
# Never commit a filled-in copy — this is a public repo.

# ── Site ───────────────────────────────────────────────────────────────
# Canonical origin, used for <link rel="canonical">, hreflang, sitemap.
# Build-time only (read by astro.config.mjs).
SITE_URL="https://micio86dev.it"

# ── PocketBase ─────────────────────────────────────────────────────────
# Public base URL of the PocketBase instance. Read at RUNTIME (not baked in):
#   • SSR data fetch in src/lib/pocketbase.ts reads process.env.PUBLIC_PB_URL
#   • the contact form (browser) POSTs to ${PUBLIC_PB_URL}/api/collections/contacts/records
# If unset / unreachable, SSR falls back to src/lib/seed-data.ts.
# Because the contact form runs in the browser, this MUST be a URL the browser
# can reach (e.g. https://pb.micio86dev.it, or http://localhost:8090 in dev).
PUBLIC_PB_URL="http://localhost:8090"
