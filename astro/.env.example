# Astro env — copy to `.env` for `astro dev` / `astro build` run directly on
# the host. When running via Docker, see ../.env.example instead:
#   • build-time (baked at `astro build`): SITE_URL, PB_URL  → Docker build args
#   • runtime    (Node server, /api/contact): RESEND_API_KEY, CONTACT_TO_EMAIL,
#     CONTACT_FROM_EMAIL, PB_ADMIN_TOKEN                     → VPS .env (env_file)
# Never commit a filled-in copy — this is a public repo.

# ── Site ───────────────────────────────────────────────────────────────
# Canonical origin, used for <link rel="canonical">, hreflang, sitemap.
SITE_URL="https://miciodev.com"

# ── PocketBase ─────────────────────────────────────────────────────────
# Base URL of the PocketBase instance. Build-time fetch reads
# `${PB_URL}/api/collections/{projects,services}/records`.
# If unset / unreachable, the build falls back to src/lib/seed-data.ts.
PB_URL="https://pb.miciodev.com"
# Optional — only needed if you write contact submissions back to a
# `messages` collection for backup.
PB_ADMIN_TOKEN=""

# ── Resend (contact form) ──────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL="alessandro@miciodev.com"
# Verified sender (must be a domain verified in Resend).
CONTACT_FROM_EMAIL="MicioDev <hello@miciodev.com>"
