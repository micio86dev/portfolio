---
import { useTranslations, type Locale } from '../../i18n/utils';
import { getSkills } from '../../lib/pocketbase';
import { SKILL_GROUPS } from '../../lib/seed-data';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Skills come from PocketBase (`skills` collection), grouped into the four
// families in SKILL_GROUPS order. Names aren't translated (tool names); the
// group display labels live in the `translations` collection / i18n JSON.
const skills = await getSkills();
const GROUPS = SKILL_GROUPS.map((g) => ({
  ...g,
  items: skills.filter((s) => s.group === g.key).sort((a, b) => a.order - b.order),
})).filter((g) => g.items.length > 0);
---

<section class="skills" aria-labelledby="skills-heading" id="skills">
  <header class="skills__head">
    <div class="skills__eyebrow"><span class="md-eyebrow"><span class="dot"></span>{t('skills.eyebrow')}</span></div>
    <h2 id="skills-heading" class="skills__title" data-reveal>{t('skills.title')}</h2>
    <p class="skills__note">{t('skills.note')}</p>
  </header>

  <div class="skills__panel">
    <div class="skills__grid" data-reveal-stagger>
      {GROUPS.map((g) => (
        <div class="skills__group" data-reveal>
          <header class="skills__group-head">
            <span class="md-eyebrow">/ {g.idx}</span>
            <h3 class="skills__group-title">{t(g.labelKey)}</h3>
          </header>
          <ul class="skills__pills">
            {g.items.map((s) => (
              <li class:list={['skills__pill', `skills__pill--${s.weight}`]}>
                {s.weight === 'primary' && <span class="skills__pill-dot" aria-hidden="true"></span>}
                {s.name}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <footer class="skills__foot">
    <div class="skills__legend">
      <span class="md-eyebrow">{t('skills.legend.label')}</span>
      <span class="skills__legend-item"><span class="skills__pill skills__pill--primary"><span class="skills__pill-dot"></span>{t('skills.legend.pillPrimary')}</span> {t('skills.legend.primary')}</span>
      <span class="skills__legend-item"><span class="skills__pill skills__pill--daily">{t('skills.legend.pillDaily')}</span> {t('skills.legend.daily')}</span>
      <span class="skills__legend-item"><span class="skills__pill skills__pill--default">{t('skills.legend.pillDefault')}</span> {t('skills.legend.default')}</span>
    </div>
    <span class="skills__foot-idx">{t('skills.footerIndex')}</span>
  </footer>
</section>

<style>
  @reference "../../styles/app.css";
  .skills {
    background: var(--bg);
    color: var(--text);
    padding: 56px 22px 64px;
  }
  @media (width >= theme(--breakpoint-lg)) { .skills { padding: 96px 64px 112px; } }

  .skills__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 28px;
  }
  @media (width >= theme(--breakpoint-lg)) {
    .skills__head {
      grid-template-columns: repeat(12, 1fr);
      column-gap: 24px;
      row-gap: 24px;
      margin-bottom: 48px;
    }
    .skills__eyebrow { grid-column: 1 / 4; }
    .skills__title { grid-column: 4 / 11; }
    .skills__note { grid-column: 11 / 13; align-self: end; text-align: right; }
  }
  .skills__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 36px;
    line-height: 1.02;
    letter-spacing: -0.022em;
  }
  @media (width >= theme(--breakpoint-lg)) { .skills__title { font-size: clamp(40px, 4.4vw, 60px); } }
  .skills__note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .skills__panel {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 24px 0;
  }
  .skills__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }
  @media (width >= theme(--breakpoint-sm)) { .skills__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (width >= theme(--breakpoint-lg)) { .skills__grid { grid-template-columns: repeat(4, 1fr); gap: 32px; } }

  .skills__group { display: flex; flex-direction: column; gap: 16px; }
  .skills__group-head { display: grid; gap: 6px; }
  .skills__group-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--text);
  }
  .skills__pills { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .skills__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 28px;
    padding: 0 12px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .skills__pill--primary {
    background: var(--brand-tint);
    color: var(--brand);
    border: 1px solid color-mix(in oklab, var(--brand) 24%, transparent);
  }
  .skills__pill--daily {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--line-2);
  }
  .skills__pill--default {
    background: transparent;
    color: var(--text-2);
    border: 1px dashed var(--line-2);
  }
  .skills__pill-dot { width: 5px; height: 5px; border-radius: 999px; background: var(--brand); }

  .skills__foot {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: baseline;
    justify-content: space-between;
  }
  @media (width >= theme(--breakpoint-lg)) { .skills__foot { margin-top: 28px; } }
  .skills__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .skills__legend-item { display: inline-flex; align-items: center; gap: 8px; }
  .skills__foot-idx {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
