---
import { useTranslations, type Locale } from '../../i18n/utils';
import { getCareer } from '../../lib/pocketbase';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// The career path comes from PocketBase (`career` collection), oldest first —
// that's the natural reading order for a "path", so the timeline runs
// top-to-bottom from where it started to where it is now. The bodies are
// localized (`body_<locale>` with a fall-through to `body_en`); the section
// intro line is a UI string (`career.intro`), editable from the admin too.
const milestones = await getCareer(lang);
---

<section class="career" aria-labelledby="career-heading" id="about">
  <header class="career__head">
    <div class="career__eyebrow"><span class="md-eyebrow"><span class="dot"></span>{t('career.eyebrow')}</span></div>
    <h2 id="career-heading" class="career__title" data-reveal>{t('career.title')}</h2>
    <p class="career__intro" data-reveal>{t('career.intro')}</p>
  </header>

  <ol class="career__timeline" data-reveal-stagger>
    {milestones.map((m) => (
      <li class="career__item" data-reveal>
        <span class="career__node" aria-hidden="true"></span>
        <div class="career__entry">
          <div class="career__meta">
            <span class="career__period">{m.period}</span>
            {m.company && <span class="career__company">{m.company}</span>}
          </div>
          <p class="career__body">{m.body}</p>
          {m.tech.length > 0 && (
            <ul class="career__tech">
              {m.tech.map((tag: string) => <li class="career__chip">{tag}</li>)}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ol>
</section>

<script>
  // Self-initialising scroll-reveal (idempotent — safe to import per section).
  import '../../scripts/scroll-reveal.ts';
</script>

<style>
  .career {
    background: var(--bg);
    color: var(--text);
    padding: 56px 22px 64px;
  }
  @media (min-width: 960px) { .career { padding: 96px 64px 112px; } }

  .career__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 32px;
  }
  @media (min-width: 960px) {
    .career__head {
      grid-template-columns: repeat(12, 1fr);
      column-gap: 24px;
      row-gap: 24px;
      margin-bottom: 56px;
    }
    .career__eyebrow { grid-column: 1 / 4; }
    .career__title { grid-column: 4 / 11; }
    .career__intro { grid-column: 4 / 11; }
  }
  .career__title {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 36px;
    line-height: 1.02;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  @media (min-width: 960px) { .career__title { font-size: clamp(40px, 4.4vw, 60px); } }
  .career__intro {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 60ch;
    text-wrap: pretty;
  }
  @media (min-width: 960px) { .career__intro { font-size: 17px; } }

  .career__timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
    position: relative;
  }
  /* the running line of the timeline */
  .career__timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 28px;
    bottom: 28px;
    width: 1px;
    background: var(--line-2);
  }
  @media (min-width: 640px) { .career__timeline::before { left: 6px; } }

  .career__item {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 20px;
    padding: 28px 0;
  }
  @media (min-width: 640px) { .career__item { gap: 28px; padding: 32px 0; } }
  .career__item + .career__item { border-top: 1px solid var(--line); }

  .career__node {
    width: 11px;
    height: 11px;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid var(--text);
    margin-top: 6px;
    flex: none;
  }
  .career__item:last-child .career__node {
    background: var(--brand);
    border-color: var(--brand);
    box-shadow: 0 0 0 4px var(--brand-tint);
  }
  @media (min-width: 640px) { .career__node { width: 13px; height: 13px; margin-top: 4px; } }

  .career__entry { display: flex; flex-direction: column; gap: 12px; }
  .career__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 14px;
  }
  .career__period {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--brand);
    text-transform: uppercase;
  }
  .career__company {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 20px;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--text);
  }
  @media (min-width: 960px) { .career__company { font-size: 24px; } }
  .career__body {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 68ch;
    text-wrap: pretty;
  }
  @media (min-width: 960px) { .career__body { font-size: 15px; } }

  .career__tech {
    list-style: none;
    margin: 2px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .career__chip {
    display: inline-flex;
    align-items: center;
    height: 26px;
    padding: 0 11px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-2);
    background: var(--surface);
    border: 1px solid var(--line-2);
    white-space: nowrap;
  }
</style>
