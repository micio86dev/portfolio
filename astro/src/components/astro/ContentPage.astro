---
// Shared layout for long-form / article content pages: a mono eyebrow with the
// brand dot, the italic serif headline, an optional sub-line, then a styled
// article wrapper for the body (<slot />). Used by /privacy, /imprint and
// /notes/[slug].
interface Props {
  eyebrow?: string;
  title: string;
  /** optional mono meta line shown under the headline (e.g. a date) */
  meta?: string;
  /** optional intro paragraph shown under the headline */
  intro?: string;
}
const { eyebrow, title, meta, intro } = Astro.props;
---

<article class="cpage">
  <header class="cpage__head">
    {eyebrow && (
      <span class="md-eyebrow cpage__eyebrow"><span class="dot"></span>{eyebrow}</span>
    )}
    <h1 class="cpage__title">{title}</h1>
    {meta && <p class="cpage__meta">{meta}</p>}
    {intro && <p class="cpage__intro">{intro}</p>}
  </header>

  <div class="cpage__body">
    <slot />
  </div>

  <slot name="after" />
</article>

<style>
  @reference "../../styles/app.css";
  .cpage {
    background: var(--bg);
    color: var(--text);
    padding: 64px 22px 88px;
    max-width: 820px;
    margin: 0 auto;
  }
  @media (width >= theme(--breakpoint-lg)) { .cpage { padding: 104px 64px 128px; } }

  .cpage__head { display: grid; gap: 18px; margin-bottom: 36px; }
  @media (width >= theme(--breakpoint-lg)) { .cpage__head { margin-bottom: 48px; } }
  .cpage__eyebrow { margin: 0; }
  .cpage__title {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 40px;
    line-height: 1.0;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  @media (width >= theme(--breakpoint-lg)) { .cpage__title { font-size: clamp(48px, 5.2vw, 76px); } }
  .cpage__meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .cpage__intro {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-2);
    max-width: 640px;
  }

  /* Article body — minimal prose styling tuned to the site tokens. */
  .cpage__body { font-size: 15px; line-height: 1.65; color: var(--text); }
  .cpage__body :global(> * + *) { margin-top: 1.1em; }
  .cpage__body :global(h2),
  .cpage__body :global(h3) {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-top: 1.8em;
  }
  .cpage__body :global(h2) { font-size: 30px; }
  .cpage__body :global(h3) { font-size: 22px; }
  .cpage__body :global(p) { color: var(--text-2); }
  .cpage__body :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--brand);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  .cpage__body :global(a:hover) { color: var(--brand); }
  .cpage__body :global(ul),
  .cpage__body :global(ol) { padding-left: 1.4em; color: var(--text-2); }
  .cpage__body :global(li + li) { margin-top: 0.4em; }
  .cpage__body :global(strong) { color: var(--text); font-weight: 600; }
  .cpage__body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-1);
    padding: 1px 5px;
  }
  .cpage__body :global(pre) {
    background: var(--surface-2);
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    padding: 16px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .cpage__body :global(pre code) { background: none; border: 0; padding: 0; }
  .cpage__body :global(blockquote) {
    border-left: 2px solid var(--brand);
    padding-left: 16px;
    color: var(--text-2);
    font-style: italic;
  }
  .cpage__body :global(hr) { border: 0; height: 1px; background: var(--line); margin: 2em 0; }
  .cpage__body :global(img) { border-radius: var(--r-3); border: 1px solid var(--line); }
  .cpage__body :global(figure) { margin: 0; }
  .cpage__body :global(figcaption) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    margin-top: 8px;
  }
</style>
