---
/**
 * Lightweight, dependency-free lightbox for image galleries.
 *
 * Drop this component once at the bottom of any page that has gallery
 * thumbnails marked with `data-lightbox` (the clickable child, expected to
 * carry the thumb in its `<img src>`), and `data-lightbox-full` (the
 * full-resolution URL to swap in), grouped under a parent with
 * `data-lightbox-group="<name>"` for arrow / swipe navigation within the
 * group.
 *
 * Built on the native `<dialog>` element so we inherit modal semantics
 * (focus trap, ESC closes, top-layer z-stacking, backdrop) for free — no
 * runtime CSS isolation hacks. The whole component is ~80 lines of
 * scoped TS and ships entirely server-side; no client framework is
 * pulled into the chunk graph.
 *
 * Mobile UX: a horizontal pointer/touch drag past 60px navigates
 * prev / next; under that threshold the dialog stays put.
 */
---

<dialog class="lb" data-lightbox-dialog aria-label="Image viewer">
  <button type="button" class="lb__close" data-lightbox-close aria-label="Close">
    <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M3 3l10 10M13 3 3 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    </svg>
  </button>
  <button type="button" class="lb__nav lb__nav--prev" data-lightbox-prev aria-label="Previous image">
    <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M10 2 4 8l6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <button type="button" class="lb__nav lb__nav--next" data-lightbox-next aria-label="Next image">
    <svg width="20" height="20" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="m6 2 6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <figure class="lb__stage">
    <img class="lb__img" data-lightbox-img alt="" />
    <figcaption class="lb__caption" data-lightbox-caption></figcaption>
  </figure>
</dialog>

<script>
  type Slide = { full: string; alt: string };

  const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox-dialog]');
  const imgEl = document.querySelector<HTMLImageElement>('[data-lightbox-img]');
  const captionEl = document.querySelector<HTMLElement>('[data-lightbox-caption]');
  const prevBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-prev]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-next]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-close]');

  if (dlg && imgEl && captionEl && prevBtn && nextBtn && closeBtn) {
    let slides: Slide[] = [];
    let index = 0;

    function render(): void {
      const s = slides[index];
      if (!s || !imgEl || !captionEl || !prevBtn || !nextBtn) return;
      imgEl.src = s.full;
      imgEl.alt = s.alt;
      captionEl.textContent = s.alt || '';
      captionEl.hidden = !s.alt;
      prevBtn.hidden = slides.length < 2;
      nextBtn.hidden = slides.length < 2;
    }

    function open(group: HTMLElement, startEl: HTMLElement): void {
      if (!dlg) return;
      const thumbs = Array.from(group.querySelectorAll<HTMLElement>('[data-lightbox]'));
      slides = thumbs.map((t) => {
        const innerImg = t.querySelector<HTMLImageElement>('img');
        return {
          full: t.dataset.lightboxFull || innerImg?.src || '',
          alt: innerImg?.alt || '',
        };
      });
      index = Math.max(0, thumbs.indexOf(startEl));
      render();
      dlg.showModal();
    }

    function step(delta: number): void {
      if (slides.length === 0) return;
      index = (index + delta + slides.length) % slides.length;
      render();
    }

    // Click delegation — any element inside a `[data-lightbox-group]` that
    // carries `data-lightbox` opens the modal at its position.
    document.addEventListener('click', (e) => {
      const trigger = (e.target as Element | null)?.closest<HTMLElement>('[data-lightbox]');
      if (!trigger) return;
      const group = trigger.closest<HTMLElement>('[data-lightbox-group]');
      if (!group) return;
      e.preventDefault();
      open(group, trigger);
    });

    prevBtn.addEventListener('click', () => step(-1));
    nextBtn.addEventListener('click', () => step(1));
    closeBtn.addEventListener('click', () => dlg.close());

    // Click on the backdrop (anywhere outside the figure / nav buttons) closes.
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });

    // Keyboard navigation — `dialog` already handles Escape.
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        step(1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        step(-1);
      }
    });

    // Touch / pointer swipe — > 60px horizontal travel triggers nav.
    let dragStartX = 0;
    let dragging = false;
    const SWIPE_THRESHOLD = 60;
    imgEl.addEventListener('pointerdown', (e) => {
      dragging = true;
      dragStartX = e.clientX;
    });
    imgEl.addEventListener('pointerup', (e) => {
      if (!dragging) return;
      dragging = false;
      const dx = e.clientX - dragStartX;
      if (Math.abs(dx) >= SWIPE_THRESHOLD) step(dx < 0 ? 1 : -1);
    });
    imgEl.addEventListener('pointercancel', () => {
      dragging = false;
    });

    // Toggle a class on <html> so the page itself can lock scroll while the
    // modal is open (avoids the iOS rubber-band).
    const observer = new MutationObserver(() => {
      document.documentElement.classList.toggle('has-lightbox-open', dlg.open);
    });
    observer.observe(dlg, { attributes: true, attributeFilter: ['open'] });
  }
</script>

<style is:global>
  html.has-lightbox-open {
    overflow: hidden;
    touch-action: none;
  }
</style>

<style>
  .lb {
    /* `<dialog>` defaults are awkward — wipe them and lay out the chrome
       ourselves. Wide on desktop, full-bleed on mobile. */
    padding: 0;
    border: none;
    margin: 0;
    inset: 0;
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    background: rgba(8, 8, 6, 0.94);
    color: #f1f1ea;
    overflow: hidden;
  }
  .lb::backdrop {
    background: rgba(8, 8, 6, 0.7);
  }
  .lb[open] {
    display: grid;
    grid-template-rows: 1fr;
    place-items: center;
  }
  .lb__stage {
    margin: 0;
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 12px;
    width: min(96vw, 1400px);
    height: 100%;
    padding: clamp(40px, 8vh, 80px) clamp(12px, 4vw, 56px);
    place-items: center;
  }
  .lb__img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
    user-select: none;
    -webkit-user-drag: none;
    cursor: grab;
    touch-action: pan-y;
  }
  .lb__img:active { cursor: grabbing; }
  .lb__caption {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.7);
    text-align: center;
    max-width: 90%;
  }
  .lb__caption[hidden] { display: none; }

  .lb__close,
  .lb__nav {
    position: fixed;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.06);
    color: #f1f1ea;
    cursor: pointer;
    transition: background var(--dur-1, 150ms) var(--ease, ease), border-color var(--dur-1, 150ms) var(--ease, ease);
  }
  .lb__close:hover,
  .lb__nav:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.32);
  }
  .lb__close {
    top: 16px;
    right: 16px;
  }
  .lb__nav--prev { left: 16px; top: 50%; transform: translateY(-50%); }
  .lb__nav--next { right: 16px; top: 50%; transform: translateY(-50%); }
  .lb__nav[hidden] { display: none; }

  @media (max-width: 600px) {
    .lb__nav { display: none; }
    .lb__stage { padding: 56px 12px 56px; }
  }
</style>
