---
// The full landing-page section stack — shared across all locale routes.
import Hero from './Hero.astro';
import SectionDivider from './SectionDivider.astro';
import Services from './Services.astro';
import Projects from './Projects.astro';
import Career from './Career.astro';
import Skills from './Skills.astro';
import Courses from './Courses.astro';
import Contact from './Contact.astro';
import { useTranslations, type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<Hero lang={lang} />

<SectionDivider label={t('dividers.services')} />
<Services lang={lang} />

<SectionDivider label={t('dividers.work')} />
<Projects lang={lang} />

<SectionDivider label={t('dividers.career')} />
<Career lang={lang} />

<SectionDivider label={t('dividers.skills')} />
<Skills lang={lang} />

<SectionDivider label={t('dividers.courses')} />
<Courses lang={lang} />

<SectionDivider label={t('dividers.contact')} />
<Contact lang={lang} />

<script>
  // Scroll-reveal for the homepage section stack (self-initialises on import).
  import '../../scripts/scroll-reveal.ts';
</script>
