---
// The full landing-page section stack — shared across all locale routes.
import Hero from './Hero.astro';
import Services from './Services.astro';
import Projects from './Projects.astro';
import Career from './Career.astro';
import Skills from './Skills.astro';
import Courses from './Courses.astro';
import Videos from './Videos.astro';
import Contact from './Contact.astro';
import Colophon from './Colophon.astro';
import { type Locale } from '../../i18n/utils';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
---

<Hero lang={lang} />

<Services lang={lang} />

<Projects lang={lang} />

<Skills lang={lang} />

<Courses lang={lang} />

<Videos lang={lang} />

<Contact lang={lang} />

<Career lang={lang} />

<Colophon lang={lang} />

