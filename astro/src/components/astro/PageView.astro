---
// Renders a `pages` collection row (e.g. /privacy, /imprint) via ContentPage.
// The route file does the getPage() fetch + 404; this component just renders a
// resolved (localized) PageItem. Shared across all locale routes.
import type { Locale } from '../../i18n/utils';
import type { PageItem } from '../../lib/seed-data';
import ContentPage from './ContentPage.astro';

interface Props {
  lang: Locale;
  page: PageItem;
  eyebrow?: string;
}
const { page, eyebrow } = Astro.props;
---

<ContentPage eyebrow={eyebrow} title={page.title}>
  <Fragment set:html={page.body} />
</ContentPage>
