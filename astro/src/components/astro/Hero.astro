---
import { Image } from 'astro:assets';
import { useTranslations, useTranslatedPath, type Locale } from '../../i18n/utils';
import { getCustomers } from '../../lib/pocketbase';
import { pbThumb } from '../../lib/img';
import { getCanaryUtcOffset } from '../../lib/canary-tz';
import heroImg from '../../assets/hero.webp';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const path = useTranslatedPath(lang);

// Trust strip — the real clients, most-recent-collaboration-first. Render the
// company logo when one's uploaded (PB `customers.logo`), otherwise the name.
const customers = await getCustomers(lang);

// `Atlantic/Canary` switches between UTC+0 (winter) and UTC+1 (summer DST).
// Compute fresh per request — the i18n string is now offset-free.
const statusLocation = `${t('status.location')} · ${getCanaryUtcOffset()}`;
---

<!-- FOUC guard — runs synchronously *before* the hero paints. Sets up the
     entrance start-states (scoped under `html.hero-anim-ready` + `prefers-
     reduced-motion: no-preference` in the <style> below) on the headline /
     sub-head / CTAs ONLY — the LCP atmosphere photo is **always** painted at
     full opacity (was 0.4 + GSAP fade-in: that delayed LCP by ~3s on slow
     networks). With JS disabled the class never lands and everything renders
     fully visible. -->
<script is:inline>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('hero-anim-ready');
  }
</script>

<section class="hero" aria-labelledby="hero-heading" id="about">
  <!-- SVG grain filter, defined once. Fine grayscale fractal noise (opaque):
       blended with soft-light it reads identically on light and dark surfaces. -->
  <svg width="0" height="0" class="hero__grain-def" aria-hidden="true">
    <filter id="md-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.86" numOctaves="2" seed="8" stitchTiles="stitch" />
      <feColorMatrix type="matrix" values="0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 0 1" />
    </filter>
  </svg>

  <!-- Atmosphere — the photo carries the light-mode atmosphere; the CSS
       mesh + dot grid take over in dark mode (the photo is hidden there). -->
  <div class="hero__atmosphere" aria-hidden="true">
    <Image
      class="hero__photo"
      src={heroImg}
      alt=""
      widths={[640, 960, 1280, 1672]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero__photo-scrim"></div>
    <div class="hero__mesh"></div>
    <div class="hero__dots"></div>
    <div class="hero__hairline"></div>
    <div class="hero__grain"></div>
    <pre class="hero__stamp">{t('hero.stamp')}</pre>
  </div>

  <!-- Corner marks -->
  <span class="hero__corner hero__corner--tl" aria-hidden="true"></span>
  <span class="hero__corner hero__corner--tr" aria-hidden="true"></span>
  <span class="hero__corner hero__corner--bl" aria-hidden="true"></span>
  <span class="hero__corner hero__corner--br" aria-hidden="true"></span>

  <div class="hero__grid">
    <header class="hero__top">
      <p class="md-eyebrow"><span class="dot"></span>{t('hero.eyebrow')}</p>
      <div class="hero__meta">
        <span>{t('hero.meta.section')}</span>
        <span>{statusLocation}</span>
        <span>{t('hero.meta.version')}</span>
      </div>
    </header>

    <h1 id="hero-heading" class="hero__headline">
      <span class="hero__line">{t('hero.headline.line1')}</span>
      <span class="hero__line"><span class="hero__accent">{t('hero.headline.accent')}</span>,</span>
      <span class="hero__line">{t('hero.headline.line3')}</span>
    </h1>

    <div class="hero__side">
      <p class="hero__subhead">{t('hero.subhead')}</p>
      <div class="hero__ctas">
        <a href={path('/#work')} class="md-btn hero__cta">{t('hero.ctaPrimary')} <span class="arrow">→</span></a>
        <a href={path('/#contact')} class="md-btn md-btn--secondary hero__cta">{t('hero.ctaSecondary')}</a>
      </div>
      <div class="hero__avail">
        <span><span class="hero__avail-dot"></span>{t('hero.availability')}</span>
        <span>↳ {t('hero.replies')}</span>
      </div>
    </div>

    <div class="hero__trust">
      <div class="hero__trust-head">
        <p class="md-eyebrow"><span class="dot"></span>{t('hero.trustedBy.label')}</p>
        <span class="hero__trust-count">{t('hero.trustedBy.count')}</span>
      </div>
      <hr class="md-hr" />
      <!-- Marquee strip — duplicated track for a seamless CSS loop. Pauses on
           hover/focus so the cards are actually clickable. On mobile and when
           the user prefers reduced motion, the loop is disabled and the strip
           becomes a swipeable overflow scroller (the clone is hidden). -->
      <div class="hero__marquee" aria-label={t('hero.trustedBy.label')}>
        <div class="hero__marquee-track">
          <ul class="hero__logos">
            {customers.map((c) => (
              <li class="hero__logo-card">
                <a class="hero__logo-link" href={path(`/customers/${c.slug}`)} aria-label={c.name}>
                  <span class="hero__logo-imgwrap">
                    {c.logoUrl ? (
                      <img
                        class="hero__logo-img"
                        src={pbThumb(c.logoUrl, '128x128f')}
                        alt=""
                        width="128"
                        height="128"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="hero__logo-fallback" aria-hidden="true">{c.name.charAt(0)}</span>
                    )}
                  </span>
                  <span class="hero__logo-name">{c.name}</span>
                  <span class="hero__logo-arrow" aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ul>
          <ul class="hero__logos hero__logos--clone" aria-hidden="true">
            {customers.map((c) => (
              <li class="hero__logo-card">
                <a class="hero__logo-link" href={path(`/customers/${c.slug}`)} tabindex="-1">
                  <span class="hero__logo-imgwrap">
                    {c.logoUrl ? (
                      <img
                        class="hero__logo-img"
                        src={pbThumb(c.logoUrl, '128x128f')}
                        alt=""
                        width="128"
                        height="128"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <span class="hero__logo-fallback">{c.name.charAt(0)}</span>
                    )}
                  </span>
                  <span class="hero__logo-name">{c.name}</span>
                  <span class="hero__logo-arrow">↗</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Hero entrance — pure CSS. The FOUC guard above added
  // `html.hero-anim-ready` pre-paint; the start-states (opacity:0 + small
  // y-translate on the headline lines, sub-head, CTAs) sit in CSS. Here we
  // just flip the `is-entered` flag on the next frame which triggers the
  // CSS transitions back to the natural state. No GSAP, no JS reads of
  // layout properties → no forced reflow, no LCP render delay (the
  // atmosphere photo is never faded by JS now).
  //
  // The class is added in a double-rAF to guarantee the browser has already
  // applied the start-state for the first paint (otherwise some engines
  // collapse the two states into one and the transition is skipped).
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    requestAnimationFrame(() =>
      requestAnimationFrame(() => document.documentElement.classList.add('hero-anim-entered')),
    );
  }
</script>

<style>
  @reference "../../styles/app.css";
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--bg);
    color: var(--text);
    min-height: 720px;
  }
  .hero__grain-def { position: absolute; }

  /* Entrance start-states — only when JS is ready AND motion is allowed, so
     there's no FOUC and no stuck-invisible content if JS fails. The LCP
     atmosphere photo is NEVER opacity-faded by JS anymore (was 0.4 → 1 via
     GSAP, which delayed LCP by ~3s on slow networks). It now paints at full
     opacity immediately; only the text/CTAs animate in. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.hero-anim-ready) .hero__headline .hero__line,
    :global(html.hero-anim-ready) .hero__subhead {
      opacity: 0;
      transform: translateY(-20px);
    }
    :global(html.hero-anim-ready) .hero__cta {
      opacity: 0;
      transform: translateY(20px);
    }
    /* Entered state (added once the page has painted) → transition back to
       the natural layout. Stagger via per-line transition-delay so it reads
       like a sequenced reveal without any JS timeline. */
    :global(html.hero-anim-entered) .hero__headline .hero__line,
    :global(html.hero-anim-entered) .hero__subhead,
    :global(html.hero-anim-entered) .hero__cta {
      opacity: 1;
      transform: none;
    }
    .hero__headline .hero__line,
    .hero__subhead,
    .hero__cta {
      transition:
        opacity 600ms var(--ease-md, cubic-bezier(0.16, 1, 0.3, 1)),
        transform 600ms var(--ease-md, cubic-bezier(0.16, 1, 0.3, 1));
    }
    .hero__headline .hero__line:nth-child(2) { transition-delay: 80ms; }
    .hero__headline .hero__line:nth-child(3) { transition-delay: 160ms; }
    .hero__subhead { transition-delay: 150ms; }
    .hero__cta:nth-child(1) { transition-delay: 300ms; }
    .hero__cta:nth-child(2) { transition-delay: 400ms; }
  }

  /* Atmosphere */
  .hero__atmosphere { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }

  /* Atmosphere photo. Full-strength in light mode; in dark mode it stays —
     just dimmed and de-saturated — so there's a faint photographic depth
     under the CSS mesh/dots without ever competing with the text. */
  .hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.92;
  }
  /* Fades the photo into the page background at the bottom (under the trust strip). */
  .hero__photo-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 55%, var(--bg) 100%);
  }
  :global([data-theme='dark']) .hero__photo {
    opacity: 0.3;
    filter: grayscale(0.5) brightness(0.85) contrast(1.05);
  }
  :global([data-theme='dark']) .hero__photo-scrim {
    background:
      radial-gradient(130% 105% at 50% 8%, transparent 0%, color-mix(in oklab, var(--bg) 55%, transparent) 60%, var(--bg) 100%),
      linear-gradient(to bottom, transparent 45%, var(--bg) 94%);
  }

  /* CSS atmosphere — layered over the dimmed photo in dark mode. */
  .hero__mesh,
  .hero__dots { display: none; }
  :global([data-theme='dark']) .hero__mesh,
  :global([data-theme='dark']) .hero__dots { display: block; }
  .hero__mesh {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(60% 50% at 88% 6%, color-mix(in oklab, var(--brand) 22%, transparent) 0%, transparent 60%),
      radial-gradient(50% 60% at 4% 92%, color-mix(in oklab, var(--brand) 14%, transparent) 0%, transparent 60%),
      radial-gradient(40% 30% at 50% 110%, color-mix(in oklab, var(--brand) 10%, transparent) 0%, transparent 70%);
    filter: blur(8px);
  }
  .hero__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(currentColor 1px, transparent 1.2px);
    background-size: 24px 24px;
    color: color-mix(in oklab, var(--text) 12%, transparent);
    -webkit-mask-image: radial-gradient(70% 60% at 50% 45%, black 0%, transparent 95%);
    mask-image: radial-gradient(70% 60% at 50% 45%, black 0%, transparent 95%);
  }
  .hero__hairline { position: absolute; top: 60px; left: 0; right: 0; height: 1px; background: var(--line); }
  /* Film grain. soft-light is theme-neutral — it lifts highlights and settles
     shadows a touch on either background. A radial mask keeps it near-zero
     under the headline/sub-head so the type stays crisp, and ramps it up
     toward the edges where it just adds texture. The grain sits below the
     content layer (.hero__grid, z-index 1), so it never blends into the text. */
  .hero__grain {
    position: absolute;
    inset: 0;
    filter: url(#md-grain);
    opacity: 0.5;
    mix-blend-mode: soft-light;
    -webkit-mask-image: radial-gradient(125% 115% at 50% 32%, transparent 0%, rgba(0, 0, 0, 0.35) 52%, #000 100%);
    mask-image: radial-gradient(125% 115% at 50% 32%, transparent 0%, rgba(0, 0, 0, 0.35) 52%, #000 100%);
  }
  :global([data-theme='dark']) .hero__grain { opacity: 0.6; }
  /* SVG feTurbulence + mix-blend-mode + mask-image is a paint/composite bomb
     on mobile (PageSpeed: Style & Layout 3.7s). Disable on small screens —
     the grain is decorative and barely visible at phone densities anyway. */
  @media (max-width: 767px) {
    .hero__grain { display: none; }
    .hero__grain-def { display: none; }
  }
  .hero__stamp {
    position: absolute;
    right: 24px;
    bottom: 18px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    color: color-mix(in oklab, var(--text) 36%, transparent);
    letter-spacing: 0.08em;
    line-height: 1.5;
    text-align: right;
    white-space: pre;
  }
  /* On mobile the trust marquee occupies the bottom of the hero, so the
     stamp would sit behind the logos. Float it up to the top-right corner
     where there's no other content (corner marks and meta row are hidden
     in this breakpoint). */
  @media (max-width: 767px) {
    .hero__stamp {
      bottom: auto;
      top: 14px;
      right: 14px;
      font-size: 9px;
    }
  }

  /* Corner marks */
  .hero__corner {
    position: absolute;
    width: 14px;
    height: 14px;
    opacity: 0.6;
    background:
      linear-gradient(var(--text-3), var(--text-3)) center / 100% 1px no-repeat,
      linear-gradient(var(--text-3), var(--text-3)) center / 1px 100% no-repeat;
  }
  .hero__corner--tl { top: 16px; left: 16px; }
  .hero__corner--tr { top: 16px; right: 16px; }
  .hero__corner--bl { bottom: 16px; left: 16px; }
  .hero__corner--br { bottom: 16px; right: 16px; }
  @media (width < theme(--breakpoint-lg)) { .hero__corner { display: none; } }

  /* Grid */
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    row-gap: 32px;
    padding: 88px 22px 28px;
  }
  @media (width >= theme(--breakpoint-lg)) {
    .hero__grid {
      grid-template-columns: repeat(12, 1fr);
      column-gap: 24px;
      row-gap: 56px;
      padding: 120px 64px 40px;
    }
  }

  .hero__top {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero__meta {
    display: none;
    gap: 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (width >= theme(--breakpoint-lg)) { .hero__meta { display: flex; } }

  .hero__headline {
    grid-column: 1 / -1;
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(48px, 11vw, 72px);
    line-height: 0.96;
    letter-spacing: -0.028em;
    text-wrap: pretty;
  }
  @media (width >= theme(--breakpoint-lg)) {
    .hero__headline { grid-column: 1 / 9; font-size: clamp(72px, 8.4vw, 132px); }
  }
  .hero__line { display: block; }
  .hero__accent { color: var(--brand); }

  .hero__side {
    grid-column: 1 / -1;
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  @media (width >= theme(--breakpoint-lg)) { .hero__side { grid-column: 9 / 13; } }
  .hero__subhead {
    margin: 0;
    font-size: 18px;
    line-height: 1.55;
    color: var(--text-2);
    max-width: 380px;
    text-wrap: pretty;
  }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__cta { height: 48px; padding: 0 22px; font-size: 15px; }
  .hero__avail {
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero__avail-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--brand);
    margin-right: 8px;
    vertical-align: 1px;
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--brand) 25%, transparent);
  }

  .hero__trust { grid-column: 1 / -1; margin-top: 16px; display: flex; flex-direction: column; gap: 18px; }
  @media (width >= theme(--breakpoint-lg)) { .hero__trust { margin-top: 24px; } }
  .hero__trust-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; }
  .hero__trust-count {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  /* Marquee. Full-bleed (extends past the grid gutter) with edge-fade masks so
     cards drift in/out of view instead of clipping. The track is a flex row
     containing the customer list twice; we animate it -50% for a seamless
     loop. Pause on hover/focus so cards remain clickable. */
  .hero__marquee {
    position: relative;
    overflow: hidden;
    margin: 4px -22px 0;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);
  }
  @media (width >= theme(--breakpoint-lg)) {
    .hero__marquee {
      margin: 8px -64px 0;
      -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);
    }
  }
  .hero__marquee-track {
    display: flex;
    width: max-content;
    will-change: transform;
    animation: hero-marquee 45s linear infinite;
  }
  .hero__marquee:hover .hero__marquee-track,
  .hero__marquee:focus-within .hero__marquee-track { animation-play-state: paused; }
  @keyframes hero-marquee {
    from { transform: translate3d(0, 0, 0); }
    to   { transform: translate3d(-50%, 0, 0); }
  }
  /* Reduced-motion only: kill the loop, expose a native swipeable strip
     (and drop the duplicate set so the user doesn't see the same logos
     twice). The edge-fade mask stays — it works for both modes. Touch
     devices keep the looping marquee — same motion as desktop. */
  @media (prefers-reduced-motion: reduce) {
    .hero__marquee {
      overflow-x: auto;
      scroll-snap-type: x proximity;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .hero__marquee::-webkit-scrollbar { display: none; }
    .hero__marquee-track { animation: none; width: max-content; }
    .hero__logos--clone { display: none; }
    .hero__logo-card { scroll-snap-align: start; }
  }
  .hero__logos {
    list-style: none;
    margin: 0;
    padding: 6px 22px;
    display: flex;
    align-items: stretch;
    gap: clamp(10px, 1.5vw, 18px);
  }
  @media (width >= theme(--breakpoint-lg)) { .hero__logos { padding: 8px 32px; } }
  .hero__logo-card { display: flex; flex: 0 0 auto; }
  /* The clickable card. Surface + border + subtle lift = unambiguous
     affordance: this is interactive, not a static badge. */
  .hero__logo-link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: clamp(132px, 16vw, 168px);
    height: clamp(124px, 14vw, 148px);
    padding: 16px 18px;
    text-decoration: none;
    color: var(--text-2);
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    border: 1px solid var(--line);
    border-radius: 14px;
    transition:
      transform var(--dur-1) var(--ease),
      border-color var(--dur-1) var(--ease),
      background var(--dur-1) var(--ease),
      box-shadow var(--dur-1) var(--ease),
      color var(--dur-1) var(--ease);
  }
  .hero__logo-link:hover,
  .hero__logo-link:focus-visible {
    transform: translateY(-2px);
    color: var(--text);
    border-color: color-mix(in oklab, var(--brand) 55%, var(--line));
    background: var(--bg);
    box-shadow: 0 10px 28px -18px color-mix(in oklab, var(--brand) 70%, transparent);
    outline: none;
  }
  .hero__logo-imgwrap {
    width: 56px;
    height: 56px;
    display: grid;
    place-items: center;
    filter: grayscale(1);
    opacity: 0.78;
    transition: filter var(--dur-1) var(--ease), opacity var(--dur-1) var(--ease);
  }
  .hero__logo-link:hover .hero__logo-imgwrap,
  .hero__logo-link:focus-visible .hero__logo-imgwrap {
    filter: none;
    opacity: 1;
  }
  .hero__logo-img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .hero__logo-fallback {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: color-mix(in oklab, var(--brand) 14%, transparent);
    color: var(--brand);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 30px;
    line-height: 1;
  }
  .hero__logo-name {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  /* Affordance: a small arrow in the top-right corner of each card hints
     "this opens somewhere". Hidden until hover/focus to keep the strip calm
     on first read, then revealed as the card lifts. */
  .hero__logo-arrow {
    position: absolute;
    top: 10px;
    right: 12px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--brand);
    opacity: 0;
    transform: translate(-2px, 2px);
    transition: opacity var(--dur-1) var(--ease), transform var(--dur-1) var(--ease);
  }
  .hero__logo-link:hover .hero__logo-arrow,
  .hero__logo-link:focus-visible .hero__logo-arrow {
    opacity: 1;
    transform: translate(0, 0);
  }
</style>
