---
// Hairline + mono "§ NN — name" label between sections. Decorative only.
interface Props {
  label: string; // e.g. "§ 02 — Services"
}
const { label } = Astro.props;
---

<div class="divider" aria-hidden="true">
  <div class="divider__inner">
    <span class="divider__label">{label}</span>
    <span class="divider__rule"></span>
  </div>
</div>

<style>
  .divider {
    padding: 0 22px;
    background: var(--bg);
  }
  @media (min-width: 960px) {
    .divider { padding: 0 64px; }
  }
  .divider__inner {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 0;
  }
  .divider__label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-3);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .divider__rule {
    flex: 1;
    height: 1px;
    background: var(--line);
  }
</style>
