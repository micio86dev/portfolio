---
import { useTranslations, type Locale } from '../../i18n/utils';
import { getServices } from '../../lib/pocketbase';
import type { ServiceIcon } from '../../lib/seed-data';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const services = await getServices(lang);

// 6-col grid: first 3 cards span 2 cols; last 2 cards span 3 cols.
const colSpan = (i: number, total: number) => (total > 3 && i >= total - 2 ? 3 : 2);

// Inline line-icon set — 28×28 viewBox, 1.4 stroke. Keys match ServiceIcon.
const ICON_SVG: Record<ServiceIcon, string> = {
  stack: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="6" y="5" width="16" height="4.6" rx="1"/><rect x="6" y="11.7" width="16" height="4.6" rx="1"/><rect x="6" y="18.4" width="16" height="4.6" rx="1"/><path d="M22 9.6 V11.7 M22 16.3 V18.4"/><circle cx="9" cy="7.3" r=".7" fill="currentColor"/><circle cx="9" cy="14" r=".7" fill="currentColor"/><circle cx="9" cy="20.7" r=".7" fill="currentColor"/></svg>`,
  api: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="9" width="7" height="10" rx="1"/><rect x="18" y="9" width="7" height="10" rx="1"/><path d="M10 12 H18 M18 16 H10"/><path d="M16 10.4 L18 12 L16 13.6 M12 14.4 L10 16 L12 17.6"/></svg>`,
  vps: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="20" height="6.5" rx="1"/><rect x="4" y="12.5" width="20" height="6.5" rx="1"/><rect x="4" y="21" width="20" height="3" rx="1"/><circle cx="20.5" cy="7.3" r=".9" fill="currentColor"/><circle cx="20.5" cy="15.8" r=".9" fill="currentColor"/><path d="M7 7.3 H15 M7 15.8 H15"/></svg>`,
  compass: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="14" cy="14" r="9"/><path d="M14 6 L17 14 L14 22 L11 14 Z" fill="currentColor" fill-opacity=".18"/><path d="M14 6 L17 14 L14 22 L11 14 Z"/></svg>`,
  magnifier: `<svg width="28" height="28" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6 q-3 0 -3 3 v3 q0 2 -1.5 2 q1.5 0 1.5 2 v3 q0 3 3 3"/><path d="M19 6 q3 0 3 3 v3 q0 2 1.5 2 q-1.5 0 -1.5 2 v3 q0 3 -3 3"/><circle cx="14" cy="13" r="2.4"/><path d="M15.7 14.7 L17.5 16.5"/></svg>`,
};
---

<section class="services" aria-labelledby="services-heading" id="services">
  <header class="services__head">
    <div class="services__eyebrow"><span class="md-eyebrow"><span class="dot"></span>{t('services.eyebrow')}</span></div>
    <h2 id="services-heading" class="services__title" data-reveal>{t('services.title')}</h2>
    <p class="services__note">{t('services.note')}</p>
  </header>

  <div class="services__grid" data-reveal-stagger>
    {services.map((s, i) => (
      <article class="services__card" style={`--span:${colSpan(i, services.length)}`} data-reveal>
        <div class="services__card-head">
          <span class="services__icon" set:html={ICON_SVG[s.icon as ServiceIcon]}></span>
          <span class="services__idx">/ {s.idx}</span>
        </div>
        <h3 class="services__card-title">{s.title}</h3>
        <hr class="md-hr" />
        <p class="services__card-desc">{s.desc}</p>
        {s.tags.length > 0 && (
          <ul class="services__tags">
            {s.tags.map((tag: string) => <li class="md-tag">{tag}</li>)}
          </ul>
        )}
      </article>
    ))}
  </div>

  <footer class="services__foot">
    <span>{t('services.footerNote')}</span>
    <span>{t('services.footerIndex')}</span>
  </footer>
</section>

<style>
  @reference "../../styles/app.css";
  .services {
    background: var(--bg);
    color: var(--text);
    padding: 64px 22px 80px;
  }
  @media (width >= theme(--breakpoint-lg)) { .services { padding: 96px 64px 112px; } }

  .services__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 32px;
  }
  @media (width >= theme(--breakpoint-lg)) {
    .services__head {
      grid-template-columns: repeat(12, 1fr);
      column-gap: 24px;
      row-gap: 40px;
      margin-bottom: 64px;
    }
    .services__eyebrow { grid-column: 1 / 4; }
    .services__title { grid-column: 4 / 11; }
    .services__note { grid-column: 11 / 13; align-self: end; text-align: right; }
  }
  .services__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 42px;
    line-height: 0.98;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  @media (width >= theme(--breakpoint-lg)) { .services__title { font-size: clamp(56px, 6vw, 92px); } }
  .services__note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .services__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
  }
  @media (width >= theme(--breakpoint-sm)) and (width < theme(--breakpoint-lg)) {
    .services__grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (width >= theme(--breakpoint-lg)) {
    .services__grid { grid-template-columns: repeat(6, 1fr); gap: 18px; }
    .services__card { grid-column: span var(--span); }
  }

  .services__card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    transition: border-color var(--dur-2) var(--ease), box-shadow var(--dur-2) var(--ease);
  }
  .services__card:hover { border-color: var(--text); box-shadow: var(--shadow-2); }
  .services__card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }
  .services__icon {
    width: 48px;
    height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--brand);
    background: var(--brand-tint);
    border: 1px solid color-mix(in oklab, var(--brand) 20%, transparent);
    border-radius: var(--r-2);
  }
  .services__idx {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.16em;
  }
  .services__card-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 26px;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .services__card-desc {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--text-2);
    text-wrap: pretty;
  }
  .services__tags {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .services__foot {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: baseline;
    justify-content: space-between;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  @media (width >= theme(--breakpoint-lg)) { .services__foot { margin-top: 56px; } }
</style>
