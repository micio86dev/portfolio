---
// /projects/[slug] — a single case study. The route file does the fetch +
// 404; this component just renders a resolved (localized) project. Shared
// across all locale routes.
import { useTranslations, useTranslatedPath, type Locale } from '../../i18n/utils';
import PbImage from '../vue/PbImage.vue';
import Lightbox from './Lightbox.astro';
import { pbThumb } from '../../lib/img';
import { renderRichText } from '../../lib/markdown';
import type { ProjectRecord, Localized } from '../../lib/seed-data';

interface Props {
  lang: Locale;
  project: Localized<ProjectRecord>;
}
const { lang, project: p } = Astro.props;
const t = useTranslations(lang);
const path = useTranslatedPath(lang);

// PB `desc` is a PB editor (HTML) field — see migration 1778618100. The
// seed-data fallback still holds Markdown, so route through `renderRichText`
// which detects format and converts only when needed.
const descHtml = renderRichText(p.desc);

// `coverUrl` is the project's hero shot; `imageUrls` is the full gallery (cover
// first), so the "extra" shots are everything after index 0.
const galleryUrls = (p.imageUrls ?? []).slice(1);
---

<article class="pdetail">
  <nav class="pdetail__breadcrumb">
    <a href={path('/projects')}>{t('projectsPage.back')}</a>
  </nav>

  <header class="pdetail__head">
    <div class="pdetail__client">
      <span class="pdetail__crest" class:list={{ 'pdetail__crest--logo': !!p.crestUrl }} aria-hidden="true">
        {p.crestUrl ? (
          <img class="pdetail__crest-img" src={pbThumb(p.crestUrl, '128x128f')} alt="" width="128" height="128" loading="lazy" decoding="async" />
        ) : p.crestInitials}
      </span>
      <div class="pdetail__client-meta">
        <span class="pdetail__client-name">
          {p.customerSlug ? (
            <a class="pdetail__client-link" href={path(`/customers/${p.customerSlug}`)}>{p.client}</a>
          ) : p.client} · / {p.idx}
        </span>
        {p.period && <span class="pdetail__period">{p.period}</span>}
      </div>
      {p.featured && (
        <span class="pdetail__badge"><span class="pdetail__badge-dot"></span>{t('projects.featuredBadge')}</span>
      )}
    </div>
    <h1 class="pdetail__title">{p.title}</h1>
  </header>

  {p.coverUrl && (
    <figure class="pdetail__cover">
      <PbImage src={pbThumb(p.coverUrl, '1280x800f')} alt={p.title} width={1280} height={800} eager />
    </figure>
  )}

  {p.kpis.length > 0 && (
    <div class="pdetail__kpis">
      <span class="md-eyebrow pdetail__kpis-label">{t('projectsPage.resultsLabel')}</span>
      <div class="pdetail__kpis-grid">
        {p.kpis.map((k) => (
          <div class="pdetail__kpi">
            <span class="pdetail__kpi-value">{k.value}</span>
            <span class="pdetail__kpi-label">{k.label}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  <div class="pdetail__body" set:html={descHtml}></div>

  {galleryUrls.length > 0 && (
    <div class="pdetail__gallery">
      <span class="md-eyebrow pdetail__gallery-label">{t('projectsPage.galleryLabel')}</span>
      <div class="pdetail__gallery-grid" data-lightbox-group="project-gallery">
        {galleryUrls.map((src) => (
          <figure class="pdetail__shot" data-lightbox data-lightbox-full={pbThumb(src, '1280x800f')}>
            <PbImage src={pbThumb(src, '800x500f')} alt="" width={800} height={500} />
          </figure>
        ))}
      </div>
    </div>
  )}

  {p.stack.length > 0 && (
    <div class="pdetail__stack">
      <span class="md-eyebrow pdetail__stack-label">{t('projectsPage.stackLabel')}</span>
      <ul>{p.stack.map((s) => <li class="pdetail__chip">{s}</li>)}</ul>
    </div>
  )}

  {(p.live_url || p.repo_url) && (
    <div class="pdetail__actions">
      {p.live_url && (
        <a class="md-btn" href={p.live_url} target="_blank" rel="noopener noreferrer">
          {t('projectsPage.live')}<span class="arrow">↗</span>
        </a>
      )}
      {p.repo_url && (
        <a class="md-btn md-btn--secondary" href={p.repo_url} target="_blank" rel="noopener noreferrer">
          {t('projectsPage.repo')}<span class="arrow">↗</span>
        </a>
      )}
    </div>
  )}

  <footer class="pdetail__foot">
    <a href={path('/projects')} class="pdetail__back">{t('projectsPage.back')}</a>
    <span class="pdetail__foot-idx">{t('projects.footerIndex')}</span>
  </footer>
</article>

<Lightbox />

<style>
  @reference "../../styles/app.css";
  .pdetail {
    background: var(--bg);
    color: var(--text);
    padding: 56px 22px 88px;
    max-width: 820px;
    margin: 0 auto;
  }
  @media (width >= theme(--breakpoint-lg)) { .pdetail { padding: 88px 64px 128px; } }

  .pdetail__breadcrumb { margin-bottom: 28px; }
  .pdetail__breadcrumb a {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-2);
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .pdetail__breadcrumb a:hover { color: var(--brand); }

  .pdetail__head { display: grid; gap: 22px; margin-bottom: 36px; }
  .pdetail__client { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .pdetail__crest {
    width: 44px; height: 44px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: 999px;
    overflow: hidden;
    flex: 0 0 auto;
    background: var(--surface-2);
    border: 1px solid var(--line-2);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
  }
  .pdetail__crest--logo { background: #fff; }
  .pdetail__crest-img { width: 100%; height: 100%; object-fit: cover; }
  .pdetail__client-meta { display: grid; gap: 2px; }
  .pdetail__client-name {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-3);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .pdetail__client-link { color: inherit; text-decoration: none; border-bottom: 1px solid color-mix(in oklab, currentColor 35%, transparent); }
  .pdetail__client-link:hover { color: var(--brand); }

  /* Hero shot + extra screenshots */
  .pdetail__cover {
    margin: 0 0 36px;
    border: 1px solid var(--line);
    border-radius: var(--r-3);
    overflow: hidden;
    background: var(--surface-2);
  }
  .pdetail__cover :global(img) { display: block; width: 100%; height: auto; }
  .pdetail__gallery { margin: 36px 0; display: grid; gap: 14px; }
  .pdetail__gallery-label { margin: 0; }
  .pdetail__gallery-grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
  @media (width >= theme(--breakpoint-md)) { .pdetail__gallery-grid { grid-template-columns: 1fr 1fr; } }
  .pdetail__shot {
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--r-2);
    overflow: hidden;
    background: var(--surface-2);
    cursor: zoom-in;
  }
  .pdetail__shot :global(img) { display: block; width: 100%; height: auto; }
  .pdetail__period { font-family: var(--font-mono); font-size: 11px; color: var(--text-2); }
  .pdetail__badge {
    display: inline-flex; align-items: center; gap: 6px;
    height: 22px; padding: 0 10px;
    border-radius: 999px;
    background: var(--brand-tint);
    color: var(--brand);
    font-family: var(--font-mono);
    font-size: 10px; font-weight: 500;
    letter-spacing: 0.16em; text-transform: uppercase;
    border: 1px solid color-mix(in oklab, var(--brand) 22%, transparent);
  }
  .pdetail__badge-dot {
    width: 5px; height: 5px; border-radius: 999px; background: var(--brand);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--brand) 18%, transparent);
  }
  .pdetail__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 40px;
    line-height: 1.0;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  @media (width >= theme(--breakpoint-lg)) { .pdetail__title { font-size: clamp(48px, 5.2vw, 76px); } }

  .pdetail__kpis {
    display: grid; gap: 14px;
    padding: 22px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    margin-bottom: 36px;
  }
  .pdetail__kpis-label { margin: 0; }
  .pdetail__kpis-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  @media (width >= theme(--breakpoint-md)) { .pdetail__kpis-grid { grid-template-columns: repeat(4, 1fr); } }
  .pdetail__kpi { display: grid; gap: 4px; }
  .pdetail__kpi-value {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1;
    color: var(--text);
  }
  .pdetail__kpi-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--text-3);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .pdetail__body { font-size: 16px; line-height: 1.7; color: var(--text-2); }
  .pdetail__body p + p { margin-top: 1.1em; }

  .pdetail__stack { display: grid; gap: 12px; margin-top: 36px; }
  .pdetail__stack-label { margin: 0; }
  .pdetail__stack ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .pdetail__chip {
    display: inline-flex; align-items: center;
    height: 24px; padding: 0 10px;
    border-radius: 999px;
    background: transparent;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 11px;
    border: 1px solid var(--line-2);
  }

  .pdetail__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  .pdetail__foot {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: baseline;
    justify-content: space-between;
  }
  .pdetail__back {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-2);
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .pdetail__back:hover { color: var(--brand); }
  .pdetail__foot-idx {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-3);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
