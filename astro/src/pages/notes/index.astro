---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotesPage from '../../components/astro/NotesPage.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('notesPage.metaTitle')} description={t('notesPage.metaDescription')}>
  <NotesPage lang={lang} />
</BaseLayout>
