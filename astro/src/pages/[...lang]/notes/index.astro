---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NotesPage from '../../../components/astro/NotesPage.astro';
import { resolveLangParam, useTranslations } from '../../../i18n/utils';

const lang = resolveLangParam(Astro.params.lang);
if (!lang) return new Response(null, { status: 404 });
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('notesPage.metaTitle')} description={t('notesPage.metaDescription')}>
  <NotesPage lang={lang} />
</BaseLayout>
