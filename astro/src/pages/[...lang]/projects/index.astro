---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectsPage from '../../../components/astro/ProjectsPage.astro';
import { resolveLangParam, useTranslations } from '../../../i18n/utils';

const lang = resolveLangParam(Astro.params.lang);
if (!lang) return new Response(null, { status: 404 });
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('projectsPage.metaTitle')} description={t('projectsPage.metaDescription')}>
  <ProjectsPage lang={lang} />
</BaseLayout>
