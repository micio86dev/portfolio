---
import '../styles/app.css';
import { getImage } from 'astro:assets';
import Nav from '../components/astro/Nav.astro';
import CookieBar from '../components/astro/CookieBar.astro';
import Footer from '../components/astro/Footer.astro';
import logoSrc from '../assets/logo-miciodev.jpg';
import {
  useTranslations,
  useTranslatedPath,
  stripLocale,
  LOCALES,
  DEFAULT_LOCALE,
  type Locale,
} from '../i18n/utils';
import { siteUrl, isStagingHost } from '../lib/seo';
import { PB_ORIGIN } from '../lib/pocketbase';

interface Props {
  lang: Locale;
  /** override <title>; falls back to the i18n meta.title */
  title?: string;
  /** override <meta description>; falls back to i18n meta.description */
  description?: string;
  /** emit <meta name="robots" content="noindex"> — for thin / legal pages */
  noindex?: boolean;
}

const { lang, noindex = false } = Astro.props;
const t = useTranslations(lang);
const path = useTranslatedPath(lang);

// Staging hosts (stage.*) must never be indexed — emit a noindex robots meta
// in addition to the per-page `noindex` flag. Both collapse into one tag.
// Check the proxied request host AND the resolved site origin (PUBLIC_SITE_URL /
// Astro.site, which is `https://stage.micio86dev.it` in the staging build) — the
// Node adapter doesn't always surface the reverse-proxy Host on Astro.url.
const isStaging =
  Astro.url.hostname.startsWith('stage.') || isStagingHost(siteUrl(Astro.site, Astro.url.href));

const title = Astro.props.title ?? t('meta.title');
const description = Astro.props.description ?? t('meta.description');
const siteName = t('meta.siteName');

const site = Astro.site ?? new URL('https://micio86dev.example');
const canonicalPath = Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, site);
const basePath = stripLocale(canonicalPath);

// hreflang triplet + x-default (default locale).
function localeUrl(l: Locale): string {
  const clean = basePath === '/' ? '/' : basePath;
  const p = l === DEFAULT_LOCALE ? clean : clean === '/' ? `/${l}/` : `/${l}${clean}`;
  return new URL(p, site).toString();
}

const ogImage = new URL(`/og/${lang}.png`, site).toString();
// Open Graph wants the full `xx_XX` form, not the bare language subtag.
const OG_LOCALE: Record<Locale, string> = { en: 'en_US', it: 'it_IT', es: 'es_ES' };

// ── Nav island props ───────────────────────────────────────────────────
// Projects renders under the `#work` anchor; Hero/about content is `#about`.
const navLinks = [
  // `active` here is only the SSR-initial paint hint; the Nav island takes over
  // active-state tracking (click + scroll-spy) on the client immediately.
  { href: path('/#about'), num: '01', label: t('nav.about'), active: true },
  { href: path('/#services'), num: '02', label: t('nav.services') },
  { href: path('/#work'), num: '03', label: t('nav.projects') },
  { href: path('/#contact'), num: '04', label: t('nav.contact') },
];
const navMessages = {
  home: t('nav.home'),
  hireMe: t('nav.hireMe'),
  mainNav: t('a11y.mainNav'),
  statusAvailable: t('status.available'),
  statusLocation: t('status.location'),
  openMenu: t('a11y.openMenu'),
  closeMenu: t('a11y.closeMenu'),
  toLight: t('a11y.toLight'),
  toDark: t('a11y.toDark'),
  language: t('a11y.language'),
};

// Optimize the brand mark via astro:assets, then hand the resolved URL to the
// Vue nav island (framework components can't use <Image> directly). Rendered
// at 30 px; 2× intrinsic for crisp retina.
const NAV_LOGO_PX = 60;
const navLogoImg = await getImage({ src: logoSrc, width: NAV_LOGO_PX, height: NAV_LOGO_PX, format: 'webp' });
const navLogo = { src: navLogoImg.src, width: NAV_LOGO_PX, height: NAV_LOGO_PX };

// ── Cookie-notice island props ─────────────────────────────────────────
const cookieMessages = {
  text: t('cookies.text'),
  accept: t('cookies.accept'),
  privacyLink: t('cookies.privacyLink'),
  ariaLabel: t('cookies.ariaLabel'),
};
const cookiePrivacyHref = path('/privacy');

// ── Content-Security-Policy ────────────────────────────────────────────
// Built per-environment so the PocketBase origin (file URLs in <img>, the
// contact-form POST) is whitelisted without hard-coding stage/prod hosts.
// YouTube video thumbnails come from i.ytimg.com (Videos.astro).
const cspImgSrc = ["'self'", 'data:', 'https://i.ytimg.com', PB_ORIGIN].filter(Boolean).join(' ');
const cspConnectSrc = ["'self'", PB_ORIGIN].filter(Boolean).join(' ');
const csp = [
  "default-src 'self'",
  "script-src 'self' 'unsafe-inline'",
  "style-src 'self' 'unsafe-inline'",
  `img-src ${cspImgSrc}`,
  "font-src 'self'",
  `connect-src ${cspConnectSrc}`,
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'self'",
].join('; ');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <!-- Baseline Content-Security-Policy. `'unsafe-inline'` for script-src is
         required by the inline theme-bootstrap below (a <meta> CSP can't carry
         a nonce); harden it with a hash if you externalise that script.
         `frame-ancestors` / X-Frame-Options must be sent as a real header.
         `img-src` / `connect-src` include the PocketBase origin (see above). -->
    <meta http-equiv="Content-Security-Policy" content={csp} />

    <!-- Theme bootstrap — runs before paint so there is no flash of the wrong palette. Must precede the stylesheet. -->
    <script is:inline>
      (function () {
        try {
          const saved = localStorage.getItem('miciodev-theme');
          const sys = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          document.documentElement.dataset.theme = saved || sys;
        } catch {
          /* localStorage blocked — leave default (light) */
        }
      })();
    </script>

    <title>{title} · {siteName}</title>
    <meta name="description" content={description} />
    {(noindex || isStaging) && <meta name="robots" content="noindex, nofollow" />}

    <!-- Preconnect to PocketBase — every <img> on the homepage (hero trust strip
         logos, project crests, project screenshots) loads from PB. Starting the
         TLS handshake before the document parser walks the body shaves ~150ms
         off each first PB request. NB: NO `crossorigin` attribute — `<img>`
         requests are non-credentialled by default, and a crossorigin preconnect
         opens a *separate* credentialled connection that the image fetch never
         reuses (PageSpeed: "Precollegamento non utilizzato" / 300ms LCP miss). -->
    {PB_ORIGIN && <link rel="preconnect" href={PB_ORIGIN} />}
    {PB_ORIGIN && <link rel="dns-prefetch" href={PB_ORIGIN} />}

    <!-- Critical fonts — start downloading ASAP, before canonical/OG resolve.
         Place the woff2 files in /public/fonts/ (see README "Fonts"). -->
    <link rel="preload" href="/fonts/instrument-serif-italic.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-regular.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="canonical" href={canonicalUrl.toString()} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- hreflang -->
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={localeUrl(l)} />)}
    <link rel="alternate" hreflang="x-default" href={localeUrl(DEFAULT_LOCALE)} />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.toString()} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={t('meta.ogAlt')} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {LOCALES.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Structured data — identity card for rich results / knowledge panel. -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        name: 'Alessandro Micelli',
        jobTitle: 'Full-Stack Freelance Developer',
        url: 'https://micio86dev.it',
        sameAs: ['https://github.com/micio86dev', 'https://youtube.com/@miciodev'],
        knowsAbout: ['Laravel', 'Vue.js', 'Nuxt', 'TypeScript', 'PHP', 'Docker'],
      })}
    />

    <link rel="icon" href="/favicon.ico" sizes="any" />

    <!-- JS-off fallback for `[data-reveal]` — the global stylesheet hides those
         elements until the IO-driven reveal script flips them, so without JS
         they would stay invisible. Restore them here. -->
    <noscript>
      <style>[data-reveal] { opacity: 1 !important; transform: none !important; }</style>
    </noscript>
  </head>

  <body>
    <a class="skip-link" href="#main">{t('a11y.skipToContent')}</a>

    <Nav
      lang={lang}
      basePath={basePath}
      links={navLinks}
      homeHref={path('/')}
      hireHref={path('/#contact')}
      logo={navLogo}
      messages={navMessages}
    />

    <main id="main">
      <slot />
    </main>

    <Footer lang={lang} />

    <CookieBar messages={cookieMessages} privacyHref={cookiePrivacyHref} />
  </body>
</html>
